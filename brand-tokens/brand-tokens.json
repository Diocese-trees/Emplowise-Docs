{
  "$comment": "Canonical Emplowise Brand Kit 2026. The CSS in tokens.css is the runtime source; this JSON is the machine-readable mirror for docs, generators, and sync checks. Keep the two in lockstep.",
  "version": "2026",
  "tagline": "Clarity Built on Structure",
  "philosophy": "Empower people. Simplify work. Build momentum.",
  "color": {
