    "supporting": {
      "navy900": "#050F26",
      "navy800": "#0B2450",
      "navy700": "#123061",
      "navy600": "#1B3F7A",
      "teal600": "#0B8276",
      "cyan": "#22D3EE",
      "cyanDeep": "#0891B2",
      "indigo": "#4F46E5",
      "violet": "#7C3AED",
      "magenta": "#D946EF",
      "amber": "#F59E0B",
      "amberDeep": "#92400E",
      "rose": "#E11D48"
    },
    "semantic": {
      "success": "#10B981",
      "warning": "#F59E0B",
      "danger": "#E11D48",
      "info": "#0EA5E9"
    },
    "neutral": {
      "slate700": "#334155",
      "slate600": "#475569",
      "slate500": "#54637A",
      "slate400": "#94A3B8",
      "slate300": "#CBD5E1",
      "line": "#E4EAF1",
      "lineStrong": "#CBD5E1",
      "sand": "#F8F4EE",
      "sandLine": "#E8DFD2"
