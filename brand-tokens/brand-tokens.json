    "surface": {
      "canvas": "#F4F9FB",
      "card": "#FFFFFF",
      "elevated": "#FFFFFF",
      "inkPrimary": "#081B3E",
      "inkMuted": "#54637A"
    }
  },
  "type": {
    "display": {
      "family": "Montserrat",
      "weights": [700, 800],
      "fallback": ["Helvetica Neue", "Arial", "sans-serif"]
    },
    "body": {
      "family": "Plus Jakarta Sans",
      "weights": [400, 500, 600],
      "fallback": ["Segoe UI", "system-ui", "-apple-system", "sans-serif"]
    },
    "mono": {
      "family": "SFMono-Regular",
      "fallback": ["ui-monospace", "Cascadia Code", "Consolas", "monospace"]
    }
  },
  "spacing": {
    "s1": "0.25rem",
    "s2": "0.5rem",
    "s3": "0.75rem",
    "s4": "1rem",
    "s5": "1.5rem",
    "s6": "2rem",
    "s7": "3rem",
    "s8": "4rem",
    "s9": "6rem"
  },
  "layout": {
    "shell": "1140px",
    "prose": "65ch",
    "headerHeight": "64px"
  },
  "radius": {
    "xs": "8px",
    "sm": "12px",
    "md": "16px",
    "lg": "22px",
    "xl": "30px",
    "pill": "999px"
  },
  "motion": {
    "ease": "cubic-bezier(0.22, 0.61, 0.36, 1)",
    "easeOut": "cubic-bezier(0.16, 1, 0.3, 1)",
    "durationFast": "0.22s",
    "duration": "0.42s",
    "durationSlow": "0.95s"
  },
  "rules": [
    "Zero neon glows, decorative gradients in body copy, or fake browser chrome.",
    "Flat surfaces with soft navy shadows; teal-to-aqua gradients reserved for emphasis.",
    "No raw [To Verify] markers in public HTML, DOCX, or PPTX bodies.",
    "Montserrat for display headings, Plus Jakarta Sans for body."
  ]
}
